{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "commitment_app (Flutter sdk gphone64 x86 64)",
            "request": "launch",
            "type": "dart",
            "deviceId": "emulator-5554"
        },
        {
            "name": "Commitment Admin Web (API)",
            "request": "launch",
